<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_marca_tree" model="ir.ui.view">
        <field name="name">marca.marca.tree</field>
        <field name="model">marca.marca</field>
        <field name="arch" type="xml">
            <tree default_order="sequence,name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="website"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_marca_form" model="ir.ui.view">
        <field name="name">marca.marca.form</field>
        <field name="model">marca.marca</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="website"/>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="logo" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_marca_search" model="ir.ui.view">
        <field name="name">marca.marca.search</field>
        <field name="model">marca.marca</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Activas" name="active_true" domain="[('active','=',True)]"/>
                <filter string="Inactivas" name="active_false" domain="[('active','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Activo" name="group_active" context="{'group_by':'active'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
